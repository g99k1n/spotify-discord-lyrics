# Server Port
PORT=3001
FRONTEND_URL=http://localhost:5173

# Discord
DISCORD_TOKEN=
STATUS_PREFIX="🎵 "
STATUS_EMOJI="🎶"
OFFSET_MS=0

# Demo Mode (true by default so you can test right away)
DEMO_MODE=true

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Must match the Redirect URI registered in the Spotify Developer Dashboard
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/api/auth/spotify/callback
