# Server Port
PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Discord User Token (Keep private!)
DISCORD_TOKEN=

# Custom Status Prefix & Emoji
STATUS_PREFIX="🎵 "
STATUS_EMOJI="🎶"

# Karaoke Timing Offset in Milliseconds (+200ms or -200ms)
OFFSET_MS=0

# Demo Mode (Simulated playback & lyrics without needing live Spotify/Discord tokens)
DEMO_MODE=true

# Spotify API Credentials (Optional, needed only for Live Spotify mode)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Must match the Redirect URI registered in the Spotify Developer Dashboard
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/api/auth/spotify/callback
